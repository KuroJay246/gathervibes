rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Gather & Savor data model
    // ===============================================================
    // Protected owner
    //   UID: WcDU2jmbopdAgDlMMWvD3TkqqbC3
    //   Email: jaylanspencer99@gmail.com
    //   Non-secret permanent owner identity. This UID path is not editable
    //   through normal organizer Settings and does not bypass validators.
    //
    // settings/accessControl
    //   approvedEmails: list<string> (secondary organizers; created only in Firebase Console)
    //
    // events/{eventId}
    //   eventId: string (immutable, must equal document ID)
    //   eventName: string (1..150)
    //   eventDate: timestamp
    //   location: string (1..250)
    //   venueName: string (0..250)
    //   eventType: supported enum
    //   eventCapabilities: optional map of supported boolean capability flags
    //   status: supported enum
    //   eventStartTime / eventEndTime: string (0..32)
    //   eventDescription: string (0..5000)
    //   capacity: int (1..100000)
    //   ticketPrice: number (0..1000000)  — backward-compat scalar
    //   priceTiers: list<map> or null
    //     { name: string, price: number>=0, status: enum }
    //   registrationRequired / complimentaryAllowed / doorPaymentAllowed: bool
    //   ticketTypeCount: int (1..12)
    //   registrationOpenDate / registrationCloseDate: timestamp|null
    //   financialPlan: organizer-entered budget map
    //   operationsPlan: organizer-entered planning map
    //   readinessChecklist: organizer-entered readiness map
    //   planningTasks / partnerRecords: organizer planning lists
    //   notes: string (0..10000)
    //   createdAt: timestamp (immutable)
    //   updatedAt: timestamp
    //
    // registrations/{registrationId}
    //   buyerName: string|null
    //   attendeeNames: list<string> (optional, max 100)
    //   ticketCode: string|null
    //   ticketAssignedAt: timestamp|null
    //   ticketAssignedBy: string|null
    //   checkedInBy: string|null
    //   attendanceRecordType: optional enum
    //   attendanceConfirmedAt: timestamp|null
    //   attendanceConfirmedBy: string|null
    //   attendanceEvidenceNote: string
    //
    // auditLogs/{logId}
    //   append-only event/registration audit record created in the same batch.
    //
    // staffProfiles/{uid}
    //   admin-managed staff profile. Staff can read only their own active profile.
    //
    // events/{eventId}/staffAssignments/{uid}
    //   admin-managed assigned-event role document. Staff can read only their own
    //   active assignments. Rules use this path to enforce assigned-event access.
    //
    // events/{eventId}/documents/{documentId}
    //   event-scoped document/link/evidence reference metadata only. No file
    //   upload, Storage path, external document body, or private credential
    //   content is stored.
    //
    // contacts/{contactId}, organizations/{organizationId}
    //   organizer-managed reusable business contact directory. These records
    //   contain contact PII and are not exposed to scanner or public users.
    //
    // events/{eventId}/contactLinks/{linkId}
    //   event-scoped relationship between a reusable contact/organization and
    //   a Working Event. This does not grant application access.
    //
    // accessRequests/{requestId}
    //   future requester-submitted access workflow document. Prototype only in
    //   repository review: not deployed, no live UI writes, admin review only.

    function isSignedIn() {
      return request.auth != null;
    }

    function protectedOwnerUid() {
      return 'WcDU2jmbopdAgDlMMWvD3TkqqbC3';
    }

    function isProtectedOwner() {
      return isSignedIn() && request.auth.uid == protectedOwnerUid();
    }

    function isApprovedAdmin() {
      return isProtectedOwner()
        || (
          isSignedIn()
          && request.auth.token.email is string
          && request.auth.token.email.lower() in
            get(/databases/$(database)/documents/settings/accessControl).data.approvedEmails
        );
    }

    function activeStaffProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/staffProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffProfiles/$(request.auth.uid)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/staffProfiles/$(request.auth.uid)).data.status == 'active';
    }

    function activeStaffAssignment(eventId) {
      return activeStaffProfile()
        && exists(/databases/$(database)/documents/events/$(eventId)/staffAssignments/$(request.auth.uid))
        && get(/databases/$(database)/documents/events/$(eventId)/staffAssignments/$(request.auth.uid)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/events/$(eventId)/staffAssignments/$(request.auth.uid)).data.eventId == eventId
        && get(/databases/$(database)/documents/events/$(eventId)/staffAssignments/$(request.auth.uid)).data.status == 'active';
    }

    function hasActiveEventAssignment(eventId, allowedRoles) {
      return activeStaffAssignment(eventId)
        && get(/databases/$(database)/documents/events/$(eventId)/staffAssignments/$(request.auth.uid)).data.role in allowedRoles;
    }

    function isAssignedScanner(eventId) {
      return hasActiveEventAssignment(eventId, ['scanner']);
    }

    function isAssignedViewer(eventId) {
      return hasActiveEventAssignment(eventId, ['viewer']);
    }

    function isAssignedEventManager(eventId) {
      return hasActiveEventAssignment(eventId, ['event-manager']);
    }

    function isAssignedOperationsHelper(eventId) {
      return hasActiveEventAssignment(eventId, ['operations-helper']);
    }

    function canReadTask(eventId) {
      return isApprovedAdmin()
        || isAssignedEventManager(eventId)
        || isAssignedViewer(eventId);
    }

    function canManageTask(eventId) {
      return isApprovedAdmin()
        || isAssignedEventManager(eventId);
    }

    function validShortId(value) {
      return value is string && value.size() > 0 && value.size() <= 128;
    }

    function validOptionalString(value, maxLength) {
      return value == null || value == '' || (value is string && value.size() <= maxLength);
    }

    function validOptionalAttendeeNames(value) {
      return value == null || (value is list && value.size() <= 100);
    }

    function validOptionalMoney(value) {
      return value == null || (value is number && value >= 0 && value <= 1000000);
    }

    function validOptionalPaymentMethod(value) {
      return value == null || value in [
        'firstpay', 'bank-transfer', 'cash', 'door', 'card', 'complimentary', 'unknown'
      ];
    }

    function validOptionalDateOnly(value) {
      return value == null || value == '' || (value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$'));
    }

    function validOptionalHttpUrl(value) {
      return value == null || value == '' || (
        value is string
        && value.size() <= 1000
        && (value.matches('^https://.*') || value.matches('^http://.*'))
      );
    }

    function validLedgerMoney(value) {
      return value is number && value >= 0 && value <= 1000000;
    }

    function validPerformedBy(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 256
        && (
          value == request.auth.token.email
          || (request.auth.uid != null && value == request.auth.uid)
        );
    }

    function validStaffProfile(data, uid) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'status', 'defaultRole',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'status', 'defaultRole',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.uid == uid
        && data.uid is string
        && data.uid.size() > 0
        && data.uid.size() <= 128
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 320
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.status in ['active', 'inactive', 'revoked']
        && data.defaultRole in ['event-manager', 'scanner', 'viewer', 'operations-helper']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.createdBy.size() <= 256
        && data.updatedBy is string
        && data.updatedBy.size() > 0
        && data.updatedBy.size() <= 256;
    }

    function validOnboardingData(data) {
      return data.keys().hasOnly([
          'version', 'startedAt', 'completed', 'completedAt', 'skippedAt',
          'lastStep', 'replayRequestedAt', 'updatedAt'
        ])
        && (!('version' in data) || (data.version is string && data.version.size() <= 64))
        && (!('startedAt' in data) || data.startedAt is timestamp)
        && (!('completed' in data) || data.completed is bool)
        && (!('completedAt' in data) || data.completedAt is timestamp)
        && (!('skippedAt' in data) || data.skippedAt is timestamp)
        && (!('lastStep' in data) || (data.lastStep is int && data.lastStep >= 0 && data.lastStep <= 23))
        && (!('replayRequestedAt' in data) || data.replayRequestedAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validStaffAssignment(data, eventId, uid) {
      return data.keys().hasAll([
          'uid', 'email', 'eventId', 'role', 'status',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'eventId', 'role', 'status', 'permissions',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.uid == uid
        && data.uid is string
        && data.uid.size() > 0
        && data.uid.size() <= 128
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 320
        && data.eventId == eventId
        && data.role in ['event-manager', 'scanner', 'viewer', 'operations-helper']
        && data.status in ['active', 'inactive', 'revoked']
        && (!('permissions' in data) || (data.permissions is map && data.permissions.keys().size() <= 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.createdBy.size() <= 256
        && data.updatedBy is string
        && data.updatedBy.size() > 0
        && data.updatedBy.size() <= 256;
    }

    function validRequestedRole(role) {
      return role in ['event-manager', 'scanner', 'viewer', 'operations-helper'];
    }

    function validAccessRequestStatus(status) {
      return status in ['pending', 'approved', 'declined', 'revoked'];
    }

    function validAccessRequest(data, requestId) {
      return data.keys().hasAll([
          'requestId', 'requesterUid', 'requesterEmail', 'requesterName',
          'requestedRole', 'requestedEventId', 'status', 'notes',
          'createdAt', 'updatedAt', 'createdBy', 'reviewedAt', 'reviewedBy'
        ])
        && data.keys().hasOnly([
          'requestId', 'requesterUid', 'requesterEmail', 'requesterName',
          'requestedRole', 'requestedEventId', 'status', 'notes',
          'createdAt', 'updatedAt', 'createdBy', 'reviewedAt', 'reviewedBy'
        ])
        && data.requestId == requestId
        && validShortId(data.requestId)
        && data.requesterUid is string
        && data.requesterUid.size() > 0
        && data.requesterUid.size() <= 128
        && data.requesterEmail is string
        && data.requesterEmail.size() > 0
        && data.requesterEmail.size() <= 320
        && data.requesterName is string
        && data.requesterName.size() > 0
        && data.requesterName.size() <= 120
        && validRequestedRole(data.requestedRole)
        && validShortId(data.requestedEventId)
        && validAccessRequestStatus(data.status)
        && data.notes is string
        && data.notes.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.createdBy.size() <= 256
        && (data.reviewedAt == null || data.reviewedAt is timestamp)
        && validOptionalString(data.reviewedBy, 256);
    }

    function accessRequestImmutableFieldsUnchanged(requestId) {
      return request.resource.data.requestId == requestId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.requesterUid == resource.data.requesterUid
        && request.resource.data.requesterEmail == resource.data.requesterEmail
        && request.resource.data.requesterName == resource.data.requesterName
        && request.resource.data.requestedRole == resource.data.requestedRole
        && request.resource.data.requestedEventId == resource.data.requestedEventId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    function accessRequestReviewFieldsValid() {
      return (
          request.resource.data.status == 'pending'
          && request.resource.data.reviewedAt == null
          && request.resource.data.reviewedBy == null
        ) || (
          request.resource.data.status in ['approved', 'declined', 'revoked']
          && request.resource.data.reviewedAt == request.time
          && validPerformedBy(request.resource.data.reviewedBy)
        );
    }

    // ── Price tier validation ──────────────────────────────────────────────
    // Each tier must have: name (supported enum), price (number >= 0), and
    // status (supported enum). Rules do not support loops, so each allowed
    // list size is checked explicitly up to MAX_PRICE_TIERS (7).

    function validPriceTier(tier) {
      return tier is map
        && tier.keys().hasAll(['name', 'price', 'status'])
        && tier.keys().hasOnly(['name', 'price', 'status'])
        && tier.name in [
          'Early Bird', 'General', 'Door', 'Tier 1', 'Tier 2', 'Tier 3', 'Complimentary'
        ]
        && tier.price is number
        && tier.price >= 0
        && tier.price <= 1000000
        && tier.status in ['active', 'sold-out', 'hidden'];
    }

    function validPriceTiers(tiers) {
      return tiers == null
        || (
          tiers is list
          && tiers.size() <= 7
          && (
            tiers.size() == 0
            || (tiers.size() == 1 && validPriceTier(tiers[0]))
            || (tiers.size() == 2 && validPriceTier(tiers[0]) && validPriceTier(tiers[1]))
            || (tiers.size() == 3 && validPriceTier(tiers[0]) && validPriceTier(tiers[1]) && validPriceTier(tiers[2]))
            || (tiers.size() == 4 && validPriceTier(tiers[0]) && validPriceTier(tiers[1]) && validPriceTier(tiers[2]) && validPriceTier(tiers[3]))
            || (tiers.size() == 5 && validPriceTier(tiers[0]) && validPriceTier(tiers[1]) && validPriceTier(tiers[2]) && validPriceTier(tiers[3]) && validPriceTier(tiers[4]))
            || (tiers.size() == 6 && validPriceTier(tiers[0]) && validPriceTier(tiers[1]) && validPriceTier(tiers[2]) && validPriceTier(tiers[3]) && validPriceTier(tiers[4]) && validPriceTier(tiers[5]))
            || (tiers.size() == 7 && validPriceTier(tiers[0]) && validPriceTier(tiers[1]) && validPriceTier(tiers[2]) && validPriceTier(tiers[3]) && validPriceTier(tiers[4]) && validPriceTier(tiers[5]) && validPriceTier(tiers[6]))
          )
        );
    }

    function validEventType(value) {
      return value in [
        'birthday', 'bridal-shower', 'wedding', 'workshop',
        'cake-tasting-food-showcase', 'cultural-experience',
        'corporate-event', 'hospitality-event', 'party',
        'private-event', 'other',
        'cake-picnic', 'cake-tasting', 'brunch', 'tasting',
        'food-event', 'vendor-pop-up', 'private-food-experience'
      ];
    }

    function validEventCapabilities(capabilities) {
      return capabilities is map
        && capabilities.keys().hasOnly([
          'publicRegistration', 'ticketing', 'checkIn', 'seating',
          'suppliers', 'vendors', 'sponsors', 'bakers', 'tastingZones',
          'allergens', 'schoolsYouth', 'speakers', 'sessions',
          'certificates', 'bridalParty', 'accommodation', 'transport'
        ])
        && capabilities.values().hasOnly([true, false]);
    }

    function validEventStatus(value) {
      return value in [
        'draft', 'planning', 'registration-open', 'registration-closed',
        'ready-for-event', 'in-progress', 'completed', 'archived',
        'cancelled', 'upcoming', 'active'
      ];
    }

    function validFinancialPlan(plan) {
      return plan is map
        && plan.keys().hasOnly([
          'projectedRegistrationIncome', 'venueBudget', 'supplierBudget',
          'entertainmentBudget', 'marketingBudget', 'staffingBudget',
          'contingencyBudget', 'otherBudget'
        ]);
    }

    function validPlanningTimeline(timeline) {
      return timeline is list && timeline.size() <= 24;
    }

    function validOperationsPlan(plan) {
      return plan is map
        && plan.keys().hasOnly([
          'venueAccessTime', 'emergencyContact', 'suppliersNote',
          'bakerVendorNote', 'sponsorNote', 'staffNote', 'equipmentNote',
          'licencesNote', 'insuranceNote', 'setupTime', 'timeline'
        ])
        && (!('timeline' in plan) || validPlanningTimeline(plan.timeline));
    }

    function validReadinessChecklist(checklist) {
      return checklist is map
        && checklist.keys().hasOnly([
          'venueConfirmed', 'venueAccessConfirmed', 'paymentMethodsConfigured',
          'suppliersConfirmed', 'staffAssigned', 'eventDayTimelineReady',
          'ticketProcessReady', 'checkInProcessReady',
          'communicationsPrepared', 'licencesReviewed', 'insuranceReviewed'
        ])
        && checklist.values().hasOnly([true, false]);
    }

    function validPlanningTasks(tasks) {
      return tasks is list && tasks.size() <= 250;
    }

    function validPartnerRecords(records) {
      return records is list && records.size() <= 250;
    }

    // ── Event allowed keys with optional planner fields ────────────────────
    function isValidEvent(data, eventId) {
      return (
          // May optionally include planner and ticket configuration fields
          data.keys().hasOnly([
            'eventId', 'eventName', 'eventDate', 'location', 'eventType',
            'status', 'capacity', 'ticketPrice', 'notes', 'createdAt', 'updatedAt',
            'priceTiers', 'venueName', 'eventStartTime', 'eventEndTime',
            'eventDescription', 'registrationRequired', 'ticketTypeCount',
            'complimentaryAllowed', 'doorPaymentAllowed',
            'registrationOpenDate', 'registrationCloseDate', 'eventCapabilities', 'financialPlan',
            'operationsPlan', 'readinessChecklist', 'planningTasks',
            'partnerRecords'
          ])
          && data.eventId == eventId
          && validShortId(data.eventId)
          && data.eventName is string
          && data.eventName.size() > 0
          && data.eventName.size() <= 150
          && data.eventDate is timestamp
          && data.location is string
          && data.location.size() > 0
          && data.location.size() <= 250
          && validEventType(data.eventType)
          && validEventStatus(data.status)
          && data.capacity is int
          && data.capacity > 0
          && data.capacity <= 100000
          && data.ticketPrice is number
          && data.ticketPrice >= 0
          && data.ticketPrice <= 1000000
          && data.notes is string
          && data.notes.size() <= 10000
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          // Optional price tiers
          && (!('priceTiers' in data) || validPriceTiers(data.priceTiers))
          && (!('venueName' in data) || validOptionalString(data.venueName, 250))
          && (!('eventStartTime' in data) || validOptionalString(data.eventStartTime, 32))
          && (!('eventEndTime' in data) || validOptionalString(data.eventEndTime, 32))
          && (!('eventDescription' in data) || validOptionalString(data.eventDescription, 5000))
          && (!('registrationRequired' in data) || data.registrationRequired is bool)
          && (!('ticketTypeCount' in data) || (data.ticketTypeCount is int && data.ticketTypeCount >= 1 && data.ticketTypeCount <= 12))
          && (!('complimentaryAllowed' in data) || data.complimentaryAllowed is bool)
          && (!('doorPaymentAllowed' in data) || data.doorPaymentAllowed is bool)
          && (!('registrationOpenDate' in data) || data.registrationOpenDate == null || data.registrationOpenDate is timestamp)
          && (!('registrationCloseDate' in data) || data.registrationCloseDate == null || data.registrationCloseDate is timestamp)
          && (!('eventCapabilities' in data) || validEventCapabilities(data.eventCapabilities))
          && (!('financialPlan' in data) || validFinancialPlan(data.financialPlan))
          && (!('operationsPlan' in data) || validOperationsPlan(data.operationsPlan))
          && (!('readinessChecklist' in data) || validReadinessChecklist(data.readinessChecklist))
          && (!('planningTasks' in data) || validPlanningTasks(data.planningTasks))
          && (!('partnerRecords' in data) || validPartnerRecords(data.partnerRecords))
        );
    }

    function isValidRegistration(data, registrationId) {
      return data.keys().hasAll([
          'registrationId', 'eventId', 'fullName', 'email', 'phone',
          'groupName', 'personsAttending', 'paymentStatus', 'paymentReference',
          'ticketStatus', 'ticketCode', 'ticketAssignedAt', 'ticketAssignedBy',
          'notes', 'checkedIn', 'checkInTime', 'checkedInBy', 'source', 'sourceRowId', 'timestamp',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'registrationId', 'eventId', 'fullName', 'email', 'phone',
          'buyerName', 'attendeeNames',
          'groupName', 'personsAttending', 'paymentStatus', 'paymentReference',
          'priceTier', 'ticketPrice', 'amountDue', 'amountPaid', 'balanceDue', 'paymentMethod',
          'paymentEvidenceClass', 'financeReviewRequired', 'needsFollowUp',
          'financeReview', 'outstandingStatus', 'complimentary',
          'ticketStatus', 'ticketCode', 'ticketAssignedAt', 'ticketAssignedBy',
          'notes', 'checkedIn', 'checkInTime', 'checkedInBy', 'source', 'sourceRowId', 'timestamp',
          'attendanceRecordType', 'attendanceConfirmedAt', 'attendanceConfirmedBy', 'attendanceEvidenceNote',
          'createdAt', 'updatedAt'
        ])
        && data.registrationId == registrationId
        && validShortId(data.registrationId)
        && validShortId(data.eventId)
        && data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() <= 250
        && (!('buyerName' in data) || validOptionalString(data.buyerName, 250))
        && (!('attendeeNames' in data) || validOptionalAttendeeNames(data.attendeeNames))
        && validOptionalString(data.email, 320)
        && validOptionalString(data.phone, 32)
        && validOptionalString(data.groupName, 250)
        && data.personsAttending is int
        && data.personsAttending >= 1
        && data.personsAttending <= 100
        && data.paymentStatus in ['paid', 'pending', 'complimentary', 'door', 'door-list', 'unknown']
        && (!('priceTier' in data) || validOptionalString(data.priceTier, 100))
        && (!('ticketPrice' in data) || validOptionalMoney(data.ticketPrice))
        && (!('amountDue' in data) || validOptionalMoney(data.amountDue))
        && (!('amountPaid' in data) || validOptionalMoney(data.amountPaid))
        && (!('balanceDue' in data) || validOptionalMoney(data.balanceDue))
        && (!('paymentMethod' in data) || validOptionalPaymentMethod(data.paymentMethod))
        && (!('paymentEvidenceClass' in data) || validOptionalString(data.paymentEvidenceClass, 120))
        && (!('financeReviewRequired' in data) || data.financeReviewRequired is bool)
        && (!('needsFollowUp' in data) || data.needsFollowUp is bool)
        && (!('financeReview' in data) || validOptionalString(data.financeReview, 120))
        && (!('outstandingStatus' in data) || validOptionalString(data.outstandingStatus, 120))
        && (!('complimentary' in data) || data.complimentary is bool)
        && validOptionalString(data.paymentReference, 250)
        && data.ticketStatus in ['no-ticket-assigned', 'partially-assigned', 'assigned']
        && validOptionalString(data.ticketCode, 32)
        && (data.ticketAssignedAt == null || data.ticketAssignedAt is timestamp)
        && validOptionalString(data.ticketAssignedBy, 256)
        && data.notes is string
        && data.notes.size() <= 10000
        && data.checkedIn is bool
        && (data.checkInTime == null || data.checkInTime is timestamp)
        && validOptionalString(data.checkedInBy, 256)
        && (!('attendanceRecordType' in data) || data.attendanceRecordType in ['none', 'scanner-confirmed', 'manual-live', 'organizer-confirmed-historical'])
        && (!('attendanceConfirmedAt' in data) || data.attendanceConfirmedAt == null || data.attendanceConfirmedAt is timestamp)
        && (!('attendanceConfirmedBy' in data) || validOptionalString(data.attendanceConfirmedBy, 256))
        && (!('attendanceEvidenceNote' in data) || validOptionalString(data.attendanceEvidenceNote, 1000))
        && data.source in ['manual', 'csv-import']
        && validOptionalString(data.sourceRowId, 128)
        && (data.timestamp == null || data.timestamp is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEventAuditLog(data, logId) {
      return data.keys().hasAll([
          'logId', 'eventId', 'action', 'targetType', 'targetId',
          'performedBy', 'timestamp', 'details'
        ])
        && data.keys().hasOnly([
          'logId', 'eventId', 'action', 'targetType', 'targetId',
          'performedBy', 'timestamp', 'details'
        ])
        && data.logId == logId
        && validShortId(data.logId)
        && validShortId(data.eventId)
        && data.action in ['event.create', 'event.update', 'event.delete']
        && data.targetType == 'event'
        && data.targetId == data.eventId
        && validPerformedBy(data.performedBy)
        && data.timestamp == request.time
        && data.details is map
        && data.details.keys().hasOnly(['eventName'])
        && data.details.eventName is string
        && data.details.eventName.size() > 0
        && data.details.eventName.size() <= 150;
    }

