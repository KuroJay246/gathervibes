    function registrationIdentityUnchanged() {
      return request.resource.data.registrationId == resource.data.registrationId
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.source == resource.data.source
        && request.resource.data.sourceRowId == resource.data.sourceRowId
        && request.resource.data.timestamp == resource.data.timestamp
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function registrationDetailsUnchanged() {
      return registrationIdentityUnchanged()
        && request.resource.data.fullName == resource.data.fullName
        && request.resource.data.email == resource.data.email
        && request.resource.data.phone == resource.data.phone
        && (!('buyerName' in request.resource.data) || !('buyerName' in resource.data) || request.resource.data.buyerName == resource.data.buyerName)
        && (!('attendeeNames' in request.resource.data) || !('attendeeNames' in resource.data) || request.resource.data.attendeeNames == resource.data.attendeeNames)
        && request.resource.data.groupName == resource.data.groupName
        && request.resource.data.personsAttending == resource.data.personsAttending
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.get('priceTier', null) == resource.data.get('priceTier', null)
        && request.resource.data.get('ticketPrice', null) == resource.data.get('ticketPrice', null)
        && request.resource.data.get('amountDue', null) == resource.data.get('amountDue', null)
        && request.resource.data.get('amountPaid', null) == resource.data.get('amountPaid', null)
        && request.resource.data.get('balanceDue', null) == resource.data.get('balanceDue', null)
        && request.resource.data.get('paymentMethod', null) == resource.data.get('paymentMethod', null)
        && request.resource.data.get('paymentEvidenceClass', null) == resource.data.get('paymentEvidenceClass', null)
        && request.resource.data.get('financeReviewRequired', null) == resource.data.get('financeReviewRequired', null)
        && request.resource.data.get('needsFollowUp', null) == resource.data.get('needsFollowUp', null)
        && request.resource.data.get('financeReview', null) == resource.data.get('financeReview', null)
        && request.resource.data.get('outstandingStatus', null) == resource.data.get('outstandingStatus', null)
        && request.resource.data.get('complimentary', null) == resource.data.get('complimentary', null)
        && request.resource.data.paymentReference == resource.data.paymentReference
        && request.resource.data.notes == resource.data.notes;
    }

    function ticketFieldsUnchanged() {
      return request.resource.data.ticketStatus == resource.data.ticketStatus
        && request.resource.data.ticketCode == resource.data.ticketCode
        && request.resource.data.ticketAssignedAt == resource.data.ticketAssignedAt
        && request.resource.data.ticketAssignedBy == resource.data.ticketAssignedBy;
    }

    function checkInFieldsUnchanged() {
      return request.resource.data.checkedIn == resource.data.checkedIn
        && request.resource.data.checkInTime == resource.data.checkInTime
        && request.resource.data.checkedInBy == resource.data.checkedInBy;
    }

    function attendanceEvidenceFieldsUnchanged() {
      return request.resource.data.get('attendanceRecordType', 'none') == resource.data.get('attendanceRecordType', 'none')
        && request.resource.data.get('attendanceConfirmedAt', null) == resource.data.get('attendanceConfirmedAt', null)
        && request.resource.data.get('attendanceConfirmedBy', null) == resource.data.get('attendanceConfirmedBy', null)
        && request.resource.data.get('attendanceEvidenceNote', '') == resource.data.get('attendanceEvidenceNote', '');
    }

    function hasNoTicketAssigned(data) {
      return data.ticketStatus == 'no-ticket-assigned'
        && data.ticketCode == null
        && data.ticketAssignedAt == null
        && data.ticketAssignedBy == null;
    }

    function hasImportedTicketCode(data) {
      return data.ticketStatus == 'assigned'
        && data.ticketCode is string
        && data.ticketCode.size() > 0
        && data.ticketCode.size() <= 32
        && data.ticketAssignedAt == null
        && data.ticketAssignedBy == null;
    }

    function isRegistrationDetailsUpdate() {
      return registrationIdentityUnchanged()
        && ticketFieldsUnchanged()
        && checkInFieldsUnchanged()
        && attendanceEvidenceFieldsUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'buyerName', 'attendeeNames', 'email', 'phone',
          'groupName', 'personsAttending', 'paymentStatus', 'paymentReference',
          'priceTier', 'ticketPrice', 'amountDue', 'amountPaid', 'balanceDue', 'paymentMethod',
          'paymentEvidenceClass', 'financeReviewRequired', 'needsFollowUp',
          'financeReview', 'outstandingStatus', 'complimentary',
          'notes', 'updatedAt'
        ]);
    }

    function validChangedRegistrationDetailFields(changedKeys) {
      return changedKeys.hasOnly([
          'fullName', 'buyerName', 'attendeeNames', 'email', 'phone',
          'groupName', 'personsAttending', 'paymentStatus', 'paymentReference',
          'priceTier', 'ticketPrice', 'amountDue', 'amountPaid', 'balanceDue', 'paymentMethod',
          'paymentEvidenceClass', 'financeReviewRequired', 'needsFollowUp',
          'financeReview', 'outstandingStatus', 'complimentary',
          'notes', 'updatedAt'
        ]);
    }

    function isTicketAssignmentUpdate() {
      return registrationDetailsUnchanged()
        && checkInFieldsUnchanged()
        && attendanceEvidenceFieldsUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ticketStatus', 'ticketCode', 'ticketAssignedAt', 'ticketAssignedBy', 'updatedAt'
        ])
        && request.resource.data.ticketStatus == 'assigned'
        && request.resource.data.ticketCode is string
        && request.resource.data.ticketCode.size() > 0
        && request.resource.data.ticketCode.size() <= 32
        && request.resource.data.ticketAssignedAt == request.time
        && validPerformedBy(request.resource.data.ticketAssignedBy);
    }

    function isTicketUnassignmentUpdate() {
      return registrationDetailsUnchanged()
        && checkInFieldsUnchanged()
        && attendanceEvidenceFieldsUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ticketStatus', 'ticketCode', 'ticketAssignedAt', 'ticketAssignedBy', 'updatedAt'
        ])
        && resource.data.ticketStatus == 'assigned'
        && request.resource.data.ticketStatus == 'no-ticket-assigned'
        && request.resource.data.ticketCode == null
        && request.resource.data.ticketAssignedAt == null
        && request.resource.data.ticketAssignedBy == null;
    }

    function isApprovedRegistrationUpdate(registrationId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasAny(['checkedIn', 'checkInTime', 'checkedInBy'])
        ? (isCheckInCompletionUpdate(registrationId) || isCheckInUndoUpdate(registrationId))
        : changedKeys.hasAny(['ticketStatus', 'ticketCode', 'ticketAssignedAt', 'ticketAssignedBy'])
          ? (isTicketAssignmentUpdate() || isTicketUnassignmentUpdate())
          : isApprovedRegistrationDetailUpdate(registrationId);
    }

    function isApprovedRegistrationDetailUpdate(registrationId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.registrationId == registrationId
        && validChangedRegistrationDetailFields(changedKeys)
        && request.resource.data.updatedAt == request.time;
    }

    function isHistoricalAttendanceUpdate(registrationId) {
      return isValidRegistration(request.resource.data, registrationId)
        && registrationDetailsUnchanged()
        && ticketFieldsUnchanged()
        && checkInFieldsUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'attendanceRecordType', 'attendanceConfirmedAt', 'attendanceConfirmedBy', 'attendanceEvidenceNote', 'updatedAt'
        ])
        && request.resource.data.registrationId == registrationId
        && request.resource.data.eventId == resource.data.eventId
        && resource.data.checkedIn == false
        && request.resource.data.checkedIn == false
        && request.resource.data.attendanceRecordType == 'organizer-confirmed-historical'
        && request.resource.data.attendanceConfirmedAt == request.time
        && validPerformedBy(request.resource.data.attendanceConfirmedBy)
        && request.resource.data.attendanceEvidenceNote is string
        && request.resource.data.attendanceEvidenceNote.size() > 0
        && request.resource.data.attendanceEvidenceNote.size() <= 1000
        && request.resource.data.updatedAt == request.time;
    }

    function checkInCompletionChangedKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'checkedIn', 'checkInTime', 'checkedInBy', 'updatedAt'
      ]);
    }

    function isCheckInCompletionUpdate(registrationId) {
      return checkInCompletionChangedKeysOnly()
        && request.resource.data.registrationId == registrationId
        && request.resource.data.eventId == resource.data.eventId
        && validShortId(request.resource.data.eventId)
        && resource.data.checkedIn == false
        && resource.data.checkInTime == null
        && request.resource.data.checkedIn == true
        && request.resource.data.checkInTime == request.time
        && validPerformedBy(request.resource.data.checkedInBy)
        && request.resource.data.updatedAt == request.time;
    }

    function isCheckInUndoUpdate(registrationId) {
      return checkInCompletionChangedKeysOnly()
        && request.resource.data.registrationId == registrationId
        && request.resource.data.eventId == resource.data.eventId
        && validShortId(request.resource.data.eventId)
        && resource.data.checkedIn == true
        && resource.data.checkInTime is timestamp
        && resource.data.checkedInBy != null
        && request.resource.data.checkedIn == false
        && request.resource.data.checkInTime == null
        && request.resource.data.checkedInBy == null
        && request.resource.data.updatedAt == request.time;
    }

    function operationIdentityUnchanged(ledgerEntryId) {
      return request.resource.data.ledgerEntryId == ledgerEntryId
        && request.resource.data.ledgerEntryId == resource.data.ledgerEntryId
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    // The allowlist is bootstrapped in the Firebase Console. Client code can
    // never create, update, or delete it.
    match /settings/accessControl {
      allow get: if isApprovedAdmin();
      allow list, create, update, delete: if false;
    }

    match /events/{eventId} {
      allow read: if isApprovedAdmin()
        || isAssignedEventManager(eventId)
        || isAssignedScanner(eventId)
        || isAssignedViewer(eventId)
        || isAssignedOperationsHelper(eventId);
      allow create: if isApprovedAdmin()
        && isValidEvent(request.resource.data, eventId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isApprovedAdmin()
        && isValidEvent(request.resource.data, eventId)
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isApprovedAdmin();
    }

    match /events/{eventId}/staffAssignments/{uid} {
      allow get: if isApprovedAdmin()
        || (
          isSignedIn()
          && request.auth.uid == uid
          && activeStaffProfile()
          && resource.data.uid == request.auth.uid
          && resource.data.eventId == eventId
          && resource.data.status == 'active'
        );
      allow list: if isApprovedAdmin()
        || (
          isSignedIn()
          && request.auth.uid == uid
          && activeStaffProfile()
          && resource.data.uid == request.auth.uid
          && resource.data.status == 'active'
        );
      allow create: if isApprovedAdmin()
        && validStaffAssignment(request.resource.data, eventId, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isApprovedAdmin()
        && validStaffAssignment(request.resource.data, eventId, uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isApprovedAdmin();
    }

    match /events/{eventId}/tasks/{taskId} {
      allow read: if canReadTask(eventId);
      allow create: if canManageTask(eventId)
        && validTask(request.resource.data, eventId, taskId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if canManageTask(eventId)
        && validTask(request.resource.data, eventId, taskId)
        && taskIdentityUnchanged(taskId)
        && request.resource.data.updatedAt == request.time;
      allow delete: if canManageTask(eventId);
    }

    match /registrations/{registrationId} {
      allow read: if isApprovedAdmin()
        || isAssignedEventManager(resource.data.eventId)
        || isAssignedScanner(resource.data.eventId)
        || isAssignedViewer(resource.data.eventId);
      allow create: if isApprovedAdmin()
        && isValidRegistration(request.resource.data, registrationId)
        && request.resource.data.checkedIn == false
        && request.resource.data.checkInTime == null
        && request.resource.data.checkedInBy == null
        && (hasNoTicketAssigned(request.resource.data) || hasImportedTicketCode(request.resource.data))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isApprovedAdmin()
        && isApprovedRegistrationUpdate(registrationId);
      allow update: if isAssignedScanner(resource.data.eventId)
        && isCheckInCompletionUpdate(registrationId);
      allow delete: if isApprovedAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isApprovedAdmin();
      allow create: if (
          isApprovedAdmin()
          && (
            request.resource.data.action in ['registration.update', 'registration.finance-update', 'registration.attendance-update']
              ? isRoutineRegistrationAuditLog(request.resource.data, logId)
              : request.resource.data.action in ['event.create', 'event.update', 'event.delete']
                ? isValidEventAuditLog(request.resource.data, logId)
                && matchesEventMutation(request.resource.data)
              : request.resource.data.action in ['ticket.assign', 'ticket.unassign', 'ticket.regenerate']
                ? isValidRegistrationAuditLog(request.resource.data, logId)
                  && matchesTicketMutation(request.resource.data)
                : request.resource.data.action in [
                    'registration.create', 'registration.delete',
                    'registration.import', 'checkin.complete', 'checkin.undo'
                  ]
                  ? isValidRegistrationAuditLog(request.resource.data, logId)
                    && matchesRegistrationMutation(request.resource.data)
                  : request.resource.data.action == 'checkin.duplicate-attempt'
                    ? isValidRegistrationAuditLog(request.resource.data, logId)
                      && matchesDuplicateCheckInAttempt(request.resource.data)
                    : request.resource.data.action in ['operation.create', 'operation.update', 'operation.cancel']
                      ? isValidOperationAuditLog(request.resource.data, logId)
                        && matchesOperationMutation(request.resource.data)
                      : request.resource.data.action in [
                          'task.create', 'task.update', 'task.status', 'task.waiting',
                          'task.blocked', 'task.completed', 'task.reopened',
                          'task.cancelled', 'task.delete'
                        ]
                        ? isValidTaskAuditLog(request.resource.data, logId)
                          && matchesTaskMutation(request.resource.data)
                        : request.resource.data.action in ['document.create', 'document.update', 'document.status', 'document.delete']
                          ? isValidDocumentAuditLog(request.resource.data, logId)
                            && matchesDocumentMutation(request.resource.data)
                          : request.resource.data.action in [
                              'contact.create', 'contact.update', 'organization.create',
                              'organization.update', 'contact-link.create', 'contact-link.update'
                            ]
                            ? isValidContactAuditLog(request.resource.data, logId)
                              && matchesContactMutation(request.resource.data)
                            : request.resource.data.action in [
                                'run-of-show.create', 'run-of-show.update',
                                'run-of-show.delayed', 'run-of-show.status',
                                'run-of-show.arrival', 'run-of-show.delete'
                              ]
                              ? isValidRunOfShowAuditLog(request.resource.data, logId)
                              : request.resource.data.action in [
                                  'resource.create', 'resource.update',
                                  'resource.status', 'resource.delete'
                                ]
                                ? isValidResourceAuditLog(request.resource.data, logId)
                                : false
          )
        ) || (
          isAssignedScanner(request.resource.data.eventId)
          && isValidRegistrationAuditLog(request.resource.data, logId)
          && (
            (
              request.resource.data.action == 'checkin.complete'
              && matchesRegistrationMutation(request.resource.data)
            )
            || (
              request.resource.data.action == 'checkin.duplicate-attempt'
              && matchesDuplicateCheckInAttempt(request.resource.data)
            )
          )
        );
      allow update, delete: if false;
    }

    match /operationsLedger/{ledgerEntryId} {
      allow read: if isApprovedAdmin()
        || isAssignedOperationsHelper(resource.data.eventId);
      allow create: if isApprovedAdmin()
        && isValidOperationLedgerEntry(request.resource.data, ledgerEntryId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isApprovedAdmin()
        && isValidOperationLedgerEntry(request.resource.data, ledgerEntryId)
        && operationIdentityUnchanged(ledgerEntryId)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /events/{eventId}/documents/{documentId} {
      allow read: if isApprovedAdmin()
        || isAssignedEventManager(eventId)
        || isAssignedViewer(eventId);
      allow create: if (isApprovedAdmin() || isAssignedEventManager(eventId))
        && validDocumentRecord(request.resource.data, eventId, documentId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (isApprovedAdmin() || isAssignedEventManager(eventId))
        && validDocumentRecord(request.resource.data, eventId, documentId)
        && documentIdentityUnchanged(documentId)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isApprovedAdmin();
    }

    match /events/{eventId}/runOfShow/{itemId} {
      allow read: if canReadTask(eventId);
      allow create: if isApprovedAdmin()
        && validRunOfShowItem(request.resource.data, eventId, itemId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isApprovedAdmin()
        && validRunOfShowItem(request.resource.data, eventId, itemId)
        && runOfShowIdentityUnchanged(itemId)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isApprovedAdmin();
    }

    match /events/{eventId}/resources/{resourceId} {
      allow read: if canReadTask(eventId);
      allow create: if isApprovedAdmin()
        && validEventResource(request.resource.data, eventId, resourceId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isApprovedAdmin()
        && validEventResource(request.resource.data, eventId, resourceId)
        && eventResourceIdentityUnchanged(resourceId)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isApprovedAdmin();
    }

    match /contacts/{contactId} {
      allow read: if isApprovedAdmin();
      allow create: if isApprovedAdmin()
        && validContactRecord(request.resource.data, contactId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isApprovedAdmin()
        && validContactRecord(request.resource.data, contactId)
        && contactIdentityUnchanged(contactId)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /organizations/{organizationId} {
      allow read: if isApprovedAdmin();
      allow create: if isApprovedAdmin()
        && validOrganizationRecord(request.resource.data, organizationId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isApprovedAdmin()
        && validOrganizationRecord(request.resource.data, organizationId)
        && organizationIdentityUnchanged(organizationId)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /events/{eventId}/contactLinks/{linkId} {
      allow read: if isApprovedAdmin()
        || isAssignedEventManager(eventId)
        || isAssignedViewer(eventId)
        || isAssignedOperationsHelper(eventId);
      allow create: if (isApprovedAdmin() || isAssignedEventManager(eventId))
        && validEventContactLink(request.resource.data, eventId, linkId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (isApprovedAdmin() || isAssignedEventManager(eventId))
        && validEventContactLink(request.resource.data, eventId, linkId)
        && eventContactLinkIdentityUnchanged(linkId)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isApprovedAdmin();
    }

    match /accessRequests/{requestId} {
      allow get: if isApprovedAdmin()
        || (
          isSignedIn()
          && resource.data.requesterUid == request.auth.uid
        );
      allow list: if isApprovedAdmin();
      allow create: if isSignedIn()
        && validAccessRequest(request.resource.data, requestId)
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isApprovedAdmin()
        && validAccessRequest(request.resource.data, requestId)
        && accessRequestImmutableFieldsUnchanged(requestId)
        && accessRequestReviewFieldsValid()
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /staffProfiles/{uid} {
      allow get: if isApprovedAdmin()
        || (
          isSignedIn()
          && request.auth.uid == uid
          && resource.data.uid == request.auth.uid
          && resource.data.status == 'active'
        );
      allow list: if isApprovedAdmin();
      allow create: if isApprovedAdmin()
        && validStaffProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isApprovedAdmin()
        && validStaffProfile(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (isProtectedOwner() || request.resource.data.defaultRole == resource.data.defaultRole)
        && (isProtectedOwner() || request.resource.data.status == resource.data.status);
      allow delete: if isApprovedAdmin();
    }

    match /staffProfiles/{uid}/preferences/onboarding {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid
        && validOnboardingData(request.resource.data);
    }

    // Reserved collections remain unavailable until their schemas and rules
    // are implemented and tested.
    match /tickets/{documentId} {
      allow read, write: if false;
    }

    match /checkIn/{documentId} {
      allow read, write: if false;
    }

    match /communications/{documentId} {
      allow read, write: if false;
    }

    match /aiDrafts/{documentId} {
      allow read, write: if false;
    }

    match /settings/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
