{
  "cli": {
    "version": ">=16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_MOBILE_BUILD_CHANNEL": "development",
        "EXPO_PUBLIC_FIREBASE_USE_EMULATORS": "false"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_MOBILE_BUILD_CHANNEL": "preview",
        "EXPO_PUBLIC_FIREBASE_USE_EMULATORS": "false"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_MOBILE_BUILD_CHANNEL": "production",
        "EXPO_PUBLIC_FIREBASE_USE_EMULATORS": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
